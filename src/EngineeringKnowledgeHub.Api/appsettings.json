{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "LocalAI": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:11434",
    "GenerationModel": "llama3",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 120,
    "EmbeddingDimensions": 768
  },
  "AllowedHosts": "*"
}
